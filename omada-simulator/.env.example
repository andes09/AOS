# Secrets only — never commit .env itself

# Jira API credentials
# Get token at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_EMAIL=your_email@example.com
JIRA_API_TOKEN=your_atlassian_api_token_here

# Omada simulator API key. Must match SIMULATOR_API_KEY in apps/api/.env.
# Static key — no refresh, no expiry. The API only honours it when
# ENVIRONMENT=local, so it's safe to reuse across runs.
OMADA_SIMULATOR_KEY=omada-sim-local-only
