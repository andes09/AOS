# Secrets only — never commit .env itself

# Jira API credentials
# Get token at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_EMAIL=your_email@example.com
JIRA_API_TOKEN=your_atlassian_api_token_here

# Omada sign-in credentials. The simulator signs in to Clerk at startup and
# auto-refreshes the session token throughout the run, so you no longer need
# to paste a __session cookie (those expire after ~60 seconds).
OMADA_EMAIL=your@email.com
OMADA_PASSWORD=your_omada_password

# Clerk publishable key — used to derive the Frontend API URL the simulator
# signs in against. Copy the value from apps/web/.env (VITE_CLERK_PUBLISHABLE_KEY).
CLERK_PUBLISHABLE_KEY=pk_test_...
