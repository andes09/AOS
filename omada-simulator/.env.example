# Secrets only — never commit .env itself

# Jira API credentials
# Get token at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_EMAIL=your_email@example.com
JIRA_API_TOKEN=your_atlassian_api_token_here

# Omada Clerk session token
# Sign in to Omada locally, open DevTools → Application → Cookies
# Copy the value of __session
OMADA_CLERK_TOKEN=your_clerk_session_token_here
