# Secrets only — never commit .env itself

# Jira API credentials
# Get token at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_EMAIL=your_email@example.com
JIRA_API_TOKEN=your_atlassian_api_token_here

# Omada Clerk session token (OPTIONAL).
# Token expires quickly. Pass fresh token via --token flag instead:
#   python -m src.main --simulate --env local --token "eyJ..."
# Get token: open http://localhost:5173, browser console:
#   await window.Clerk.session.getToken()
OMADA_CLERK_TOKEN=
